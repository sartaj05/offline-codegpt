# Copy this file to .env or export the variable in your shell.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
# Keep this true for local SQLite/offline development. Render sets it to false.
DJANGO_DEBUG=true
# Leave DATABASE_URL empty locally to use SQLite. Neon provides a PostgreSQL URL.
DATABASE_URL=
DATABASE_SSLMODE=require
DATABASE_CONN_MAX_AGE=60
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
OLLAMA_VISION_MODEL=llava:latest
