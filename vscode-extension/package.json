{
  "name": "syntax-local-ai",
  "displayName": "Syntax Local AI",
  "description": "Use your local Syntax Local AI server inside VS Code.",
  "version": "0.1.0",
  "publisher": "syntax-local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onCommand:syntaxLocalAI.askSelection",
    "onCommand:syntaxLocalAI.reviewFile"
    ,"onCommand:syntaxLocalAI.explainSelection"
    ,"onCommand:syntaxLocalAI.generateTests"
    ,"onCommand:syntaxLocalAI.askProject"
    ,"onCommand:syntaxLocalAI.applyLastSuggestion"
    ,"onCommand:syntaxLocalAI.runProjectTests"
    ,"onCommand:syntaxLocalAI.previewLastSuggestion"
    ,"onCommand:syntaxLocalAI.clearDiagnostics"
    ,"onCommand:syntaxLocalAI.configureHybrid"
    ,"onCommand:syntaxLocalAI.hybridStatus"
    ,"onCommand:syntaxLocalAI.queueHybridTask"
    ,"onCommand:syntaxLocalAI.refreshHybridTasks"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "syntaxLocalAI.askSelection",
        "title": "Syntax Local AI: Ask About Selection"
      },
      {
        "command": "syntaxLocalAI.reviewFile",
        "title": "Syntax Local AI: Review Current File"
      },
      {
        "command": "syntaxLocalAI.explainSelection",
        "title": "Syntax Local AI: Explain Selection"
      },
      {
        "command": "syntaxLocalAI.generateTests",
        "title": "Syntax Local AI: Generate Tests"
      },
      {
        "command": "syntaxLocalAI.askProject",
        "title": "Syntax Local AI: Ask Project"
      },
      {
        "command": "syntaxLocalAI.applyLastSuggestion",
        "title": "Syntax Local AI: Apply Last Suggested Code"
      },
      {
        "command": "syntaxLocalAI.runProjectTests",
        "title": "Syntax Local AI: Run Approved Project Tests"
      },
      {
        "command": "syntaxLocalAI.previewLastSuggestion",
        "title": "Syntax Local AI: Preview Last Suggested Patch"
      },
      {
        "command": "syntaxLocalAI.clearDiagnostics",
        "title": "Syntax Local AI: Clear Diagnostics"
      },
      {
        "command": "syntaxLocalAI.configureHybrid",
        "title": "Syntax Local AI: Configure Hybrid Connector"
      },
      {
        "command": "syntaxLocalAI.hybridStatus",
        "title": "Syntax Local AI: Show Hybrid Connector Status"
      },
      {
        "command": "syntaxLocalAI.queueHybridTask",
        "title": "Syntax Local AI: Queue Hybrid Coding Task"
      },
      {
        "command": "syntaxLocalAI.refreshHybridTasks",
        "title": "Syntax Local AI: Refresh Hybrid Tasks"
      }
    ],
    "configuration": {
      "title": "Syntax Local AI",
      "properties": {
        "syntaxLocalAI.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "Local Syntax Local AI server URL."
        },
        "syntaxLocalAI.testCommand": {
          "type": "string",
          "default": "python manage.py test",
          "description": "Local test command. It runs only after explicit confirmation."
        },
        "syntaxLocalAI.accessToken": {
          "type": "string",
          "default": "",
          "description": "Optional local workspace bearer token. Do not commit this value."
        }
      }
    }
  }
}
